# Copy this file to .env for local development. Keep real credentials in .env.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional separate model for checking the original medical document image.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# Optional: set this if the Tesseract executable is not available on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
APP_URL=http://127.0.0.1:5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-project-anon-key
