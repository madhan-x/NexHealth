# Copy this file to .env for local development. Keep real credentials in .env.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.5-flash
APP_URL=http://127.0.0.1:5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-project-anon-key
# Only needed by db.py if you later connect its server-side database helpers.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
