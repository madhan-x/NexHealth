# Vercel builds this container so the native Tesseract OCR engine is present
# in production, while the existing Dockerfile and Compose setup remain for local use.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TESSERACT_CMD=/usr/bin/tesseract

RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt "gunicorn>=22.0,<24.0"

RUN groupadd --system nexhealth \
    && useradd --system --gid nexhealth --home-dir /app --no-create-home nexhealth

COPY --chown=nexhealth:nexhealth . .

USER nexhealth
EXPOSE 80

# Vercel supplies PORT; 80 is the documented default for container functions.
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT:-80} --workers 1 --timeout 120 app:app"]
